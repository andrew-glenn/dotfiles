# Ghostty Config — Mid-dark (glare-resistant)

quit-after-last-window-closed = true
quick-terminal-animation-duration = 1
confirm-close-surface = false
resize-overlay = never
window-inherit-working-directory = false
scrollback-limit = 429496729
link-url = false 

# Font
font-family = "Hack Nerd Font Mono"
font-style = medium
font-size = 23

# Window / padding
window-padding-x = 45
window-padding-y = 20

# Transparency
background-opacity = 1.0

# Keybindings
keybind = super+shift+f=toggle_fullscreen

theme = outdoor-dark
